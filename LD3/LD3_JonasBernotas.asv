x = 0:0.5:2*pi;
f = sin(x) + cos(x).^2;
figure(1) %[output:06bd2a89]
plot(x, f, '-o', 'MarkerEdgeColor', 'r', 'MarkerFaceColor', 'y'); %[output:06bd2a89]
xlabel('x'); %[output:06bd2a89]
ylabel('y'); %[output:06bd2a89]
title('Funkcijos f(x) grafikas'); %[output:06bd2a89]
axis([min(x) max(x) min(f) max(f)]); %[output:06bd2a89]
legend('f(x)=sin(x)+cos(x)^2'); %[output:06bd2a89]
grid on; %[output:06bd2a89]

clear

x = 0:0.01:1.2;
f1 = x.^exp(1);
f2 = x.^(exp(1)*2);
f3 = x.^(exp(1)*3);

figure(2) %[output:5195edcc]
plot(x, f1, x, f2, x, f3) %[output:5195edcc]
xlabel('x'); %[output:5195edcc]
ylabel('y');title('Funkcijių f(x) grafikai'); %[output:5195edcc]
f_all = [f1 f2 f3];
axis([min(x) max(x) min(f_all) max(f_all)]); %[output:5195edcc]
legend('f(x) = x^e', 'f(x) = x^(2e)', 'f(x) = x^(3e)', 'Location','northwest'); %[output:5195edcc]
grid on; %[output:5195edcc]
%%
clear
close all

x = -2*pi:0.5:2*pi;
y = x.^3 + sin(x);

u = zeros(size(x));

figure(1) %[output:3470fff8]
quiver(x, u, u, y) %[output:3470fff8]
xlabel('x'); %[output:3470fff8]
ylabel('y'); %[output:3470fff8]
title('Funkcijos y(x) = x^3 + sin(x) vektoriai'); %[output:3470fff8]
grid on; %[output:3470fff8]

figure(2) %[output:21c2cf1e]
bar(x, y) %[output:21c2cf1e]
xlabel('x'); %[output:21c2cf1e]
ylabel('y'); %[output:21c2cf1e]
title('Funkcijos y(x) = x^3 + sin(x) stulpelinė diagrama'); %[output:21c2cf1e]
grid on; %[output:21c2cf1e]
%%
clear
close all

A = 7; f = 8; sigma = 2; U1 = 4; U2 = 3;
t = 0:0.002:2;
s = A*sin(2*pi*f*t) + 0.5*A*cos(4*pi*f*t);
n = sigma*randn(size(t));
st = s + n;

U = st > U1;
a = st(U);

sf = st;
sf(abs(sf) < U2) = 0;


figure(1) %[output:3afe5cd8]
subplot(2, 1, 1); %[output:3afe5cd8]
plot(t, st, 'k'); %[output:3afe5cd8]
hold on; %[output:3afe5cd8]
plot(t, sf, 'color', [0.5 0 0.5]); %[output:3afe5cd8]
yline(U1, '--b'); %[output:3afe5cd8]
yline(-U1, '--b'); %[output:3afe5cd8]
yline(U2, '-g');  %[output:3afe5cd8]
yline(-U2, '-g'); %[output:3afe5cd8]
title('Pradinis ir filtruotas signalai'); %[output:3afe5cd8]
xlabel('t, s', 'Color', 'r', 'FontSize', 13, 'FontWeight', 'bold'); %[output:3afe5cd8]
ylabel('U, V', 'Color', 'r', 'FontSize', 13, 'FontWeight', 'bold'); %[output:3afe5cd8]
legend('Pradinis signalas', 'Filtruotas signalas', 'Riba U_1', '', 'Riba U_2', 'Location', 'southwestoutside'); %[output:3afe5cd8]
grid on; %[output:3afe5cd8]
ylim([-20 15]) %[output:3afe5cd8]

ind_U1 = st > U1; 
t_U1 = t(ind_U1);
st_U1 = st(ind_U1);
[max_val, max_idx] = max(st);
[min_val, min_idx] = min(st);

subplot(2, 1, 2); %[output:3afe5cd8]
stem(t_U1, st_U1); %[output:3afe5cd8]
hold on %[output:3afe5cd8]
plot(t(min_idx), min_val, 'sq', 'MarkerFaceColor', 'y') %[output:3afe5cd8]
plot(t(max_idx), max_val, 'or') %[output:3afe5cd8]

title('Pradinio signalo reikšmės > U_1 ir ekstremumai') %[output:3afe5cd8]
xlabel('t, s', 'Color', 'r', 'FontSize', 13, 'FontWeight', 'bold'); %[output:3afe5cd8]
ylabel('U, V', 'Color', 'r', 'FontSize', 13, 'FontWeight', 'bold'); %[output:3afe5cd8]
legend('Reikšmės > U_1', 'Minimali reikšmė', 'Maksimali reikšmė', 'Location', 'southwestoutside'); %[output:3afe5cd8]
grid on; %[output:3afe5cd8]
ylim([-20 15]) %[output:3afe5cd8]

