x = 0:0.5:2*pi;
f = sin(x) + cos(x).^2;
figure(1) %[output:46195200]
plot(x, f, '-o', 'MarkerEdgeColor', 'r', 'MarkerFaceColor', 'y'); %[output:46195200]
xlabel('x'); %[output:46195200]
ylabel('y'); %[output:46195200]
title('Funkcijos f(x) grafikas'); %[output:46195200]
axis([min(x) max(x) min(f) max(f)]); %[output:46195200]
legend('f(x)=sin(x)+cos(x)^2'); %[output:46195200]
grid on; %[output:46195200]

clear

x = 0:0.01:1.2;
f1 = x.^exp(1);
f2 = x.^(exp(1)*2);
f3 = x.^(exp(1)*3);

figure(2) %[output:9ac9c92a]
plot(x, f1, x, f2, x, f3) %[output:9ac9c92a]
xlabel('x'); %[output:9ac9c92a]
ylabel('y'); %[output:9ac9c92a]
title('Funkcijių f(x) grafikai'); %[output:9ac9c92a]
f_all = [f1 f2 f3];
axis([min(x) max(x) min(f_all) max(f_all)]); %[output:9ac9c92a]
legend('f(x) = x^e', 'f(x) = x^(2e)', 'f(x) = x^(3e)', 'Location','northwest'); %[output:9ac9c92a]
grid on; %[output:9ac9c92a]
%%
clear
close all

x = -2*pi:0.5:2*pi;
y = x.^3 + sin(x);

u = zeros(size(x));

figure(1) %[output:01b2c361]
quiver(x, u, u, y) %[output:01b2c361]
xlabel('x'); %[output:01b2c361]
ylabel('y'); %[output:01b2c361]
title('Funkcijos y(x) = x^3 + sin(x) vektoriai'); %[output:01b2c361]
grid on; %[output:01b2c361]

figure(2) %[output:129a5b7f]
bar(x, y) %[output:129a5b7f]
xlabel('x'); %[output:129a5b7f]
ylabel('y'); %[output:129a5b7f]
title('Funkcijos y(x) = x^3 + sin(x) stulpelinė diagrama'); %[output:129a5b7f]
grid on; %[output:129a5b7f]
%%
clear
close all

A = 7; f = 8; sigma = 2; U1 = 4; U2 = 3;
t = 0:0.002:2; s = A*sin(2*pi*f*t) + 0.5*A*cos(4*pi*f*t);
n = sigma*randn(size(t));
st = s + n;

U = st > U1;
a = st(U);

sf = a;
sf(abs(sf) < U2) = 0;

figure(1) %[output:9bfbd880]
subplot(2, 1, 1) %[output:9bfbd880]
plot(st) %[output:9bfbd880]
subplot(2, 1, 2) %[output:9bfbd880]
plot(sf) %[output:9bfbd880]



