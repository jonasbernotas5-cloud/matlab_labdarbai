clear
ca = { 1, [1 2 3 4], false, 'text'} %[output:55c7a8f9]

cellfun(@(x) isnumeric(x) && isreal(x), ca) %[output:08774db6]
%%
clear

while true %[output:group:51af6073]
    a = input('Iveskite a: ') %[output:5c78bc4b] %[output:7b1be35c]
    b = input('Iveskite b: ') %[output:23f4d127] %[output:13e2a500]
    c = input('Iveskite c: ') %[output:3e6952b3] %[output:84e1c6c5]
    x = input('Iveskite x: ') %[output:3555f630] %[output:5d1c18fe]

    if a == 2 && b == 2 && c == 1 && x == 1
        disp('Ivestos baigiamojo ciklo reiksmes. Programa baigia darba.'); %[output:7a232c6d]
        break;
    end
    
    f = a*x^2 + b*x + c;
    disp('atsakymas: ') %[output:56871b86]
    disp(f) %[output:5dfe45a5]
end %[output:group:51af6073]
%%
clear

x = input('iveskite x reiksme: ') %[output:0434a64b]
y = input('iveskite y reiksme: ') %[output:51100326]

for i = 1:20 %[output:group:46f201fa]
    m = randi([1 x]);
    n = randi([1 y]);

    A = zeros(x, y);
    A(m, n) = NaN;
    disp(A) %[output:147ae7c6]

    pause(0.5);
    clc;
end %[output:group:46f201fa]


